# Copy this file to .env and fill it in.  NEVER commit .env itself.

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models. If gemini-embedding-001 is rejected, try text-embedding-004.
CHAT_MODEL=gemini-2.5-flash
EMBED_MODEL=gemini-embedding-001

# Admin panel password. Leave empty to disable the admin routes entirely.
ADMIN_PASSWORD=

# Where the frontend is served from. "*" while developing; on a split deploy put
# the real origin, e.g. https://seba-sohayok.pages.dev
ALLOWED_ORIGINS=*

# Retrieval: below this cosine score the agent refuses rather than guesses.
CONF_THRESHOLD=0.62

# Rate limits per client IP (only the Gemini path is counted).
RATE_PER_MIN=8
RATE_PER_DAY=300
